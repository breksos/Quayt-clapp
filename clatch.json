{
  "manifestVersion": 1,
  "id": "com.arfium.quayt",
  "name": "Quayt",
  "description": "Secure desktop terminal with OIDC sign-in and server-verified tenant access.",
  "version": "0.1.0",
  "protocol": 2,
  "icon": "assets/icon.png",
  "launch": { "macos": "bin/quayt", "args": ["app"] },
  "connector": {
    "cli": "quayt",
    "cliBin": "bin/quayt",
    "commands": [
      { "name": "status", "about": "show the current Quayt connection status" },
      { "name": "show", "about": "show the Quayt window" },
      { "name": "hide", "about": "hide the Quayt window" },
      { "name": "quit", "about": "quit Quayt" },
      { "name": "ping", "about": "check whether Quayt is running" }
    ],
    "signals": []
  }
}

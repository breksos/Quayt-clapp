{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quayt",
  "version": "0.1.0",
  "identifier": "com.arfium.quayt",
  "build": {"beforeDevCommand":"npm run dev","beforeBuildCommand":"npm run build:web","devUrl":"http://127.0.0.1:1420","frontendDist":"../dist"},
  "app": {
    "windows": [{"label":"main","title":"Quayt","width":980,"height":680,"minWidth":720,"minHeight":520}],
    "security": {"csp":"default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {"active":false,"icon":["../assets/icon.png"],"targets":"all"}
}

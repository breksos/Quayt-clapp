# Copy to .env for local Phase 2 development. Do not commit .env.
QUAYT_ENV=development
QUAYT_DATABASE_URL=postgresql+psycopg://quayt_dev:quayt_dev_only@127.0.0.1:54329/quayt_dev
QUAYT_ALLOWED_ORIGINS=http://127.0.0.1:1420

# Replace each OIDC value with metadata from a loopback development identity provider.
QUAYT_AUTH_ISSUER=http://127.0.0.1:9000
QUAYT_AUTH_AUDIENCE=REPLACE_WITH_DEVELOPMENT_AUDIENCE
QUAYT_AUTH_JWKS_URL=http://127.0.0.1:9000/REPLACE_WITH_JWKS_PATH
QUAYT_AUTHORIZATION_ENDPOINT=http://127.0.0.1:9000/REPLACE_WITH_AUTHORIZE_PATH
QUAYT_TOKEN_ENDPOINT=http://127.0.0.1:9000/REPLACE_WITH_TOKEN_PATH
QUAYT_OIDC_CLIENT_ID=REPLACE_WITH_DEVELOPMENT_CLIENT_ID
QUAYT_OIDC_SCOPES=openid profile

# Generate locally: python3 -c 'import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip("="))'
QUAYT_SESSION_HASH_KEY=REPLACE_WITH_URLSAFE_BASE64_32_BYTE_SECRET
